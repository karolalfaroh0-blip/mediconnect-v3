# =========================================================
# MediConnect · ejemplo de configuracion
# Copia este archivo como .env y rellena TUS valores.
# .env esta en .gitignore: nunca se sube al repositorio.
#
# OJO: el frontend NO lee este archivo. La app es estatica y
# no tiene secretos. Esto es para las herramientas y para n8n.
# =========================================================

# --- Direccion publica de la app (para generar el QR publico) ---
MC_URL_PUBLICA=https://karolalfaroh0-blip.github.io/mediconnect-v3/

# --- Webhook de TU n8n personal (no es secreto, pero cambia seguido) ---
MC_N8N_BASE=https://karolalfaro.app.n8n.cloud/webhook

# --- Solo para n8n, nunca para el navegador ---
# Estos valores NO van aqui ni en ningun archivo del repositorio:
# se guardan dentro de n8n, en Credentials.
#   · Gmail OAuth2: Client ID y Client Secret de Google Cloud
#   · Cuenta de Gmail personal autorizada
